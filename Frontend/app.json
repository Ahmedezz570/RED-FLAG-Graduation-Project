{
  "expo": {
    "name": "RED FLAG",
    "slug": "red-flag-mobile",
    "version": "0.1.0",
    "scheme": "redflag",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.redflag.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.redflag.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F5EF",
          "image": "./assets/flag.png",
          "imageWidth": 132,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
